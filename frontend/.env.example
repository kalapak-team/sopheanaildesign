NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Production (Vercel): set to your Railway API URL, e.g.
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api

# Optional: custom Cloudflare R2 / CDN hostname for next/image
# (r2.dev wildcards are already allowed in next.config.ts)
# NEXT_PUBLIC_R2_HOST=cdn.yourdomain.com
